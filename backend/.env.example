# Copy to .env and fill in — never commit the real .env file.

# PostgreSQL connection string. For local dev:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sarika_beauty_hub?schema=public"
# For a managed provider (Neon, Supabase, Railway, etc.), use the
# connection string they give you — usually needs `?sslmode=require`.
DATABASE_URL=""

# Three independent JWT secrets — one per role (admin / delivery agent /
# customer) — deliberately different values so a leaked one can't be
# used to forge a session for a different, more-privileged role. Any
# long random string works, e.g. `openssl rand -base64 32`.
ADMIN_JWT_SECRET=""
AGENT_JWT_SECRET=""
CUSTOMER_JWT_SECRET=""

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Signing secret you set when configuring the webhook in the Razorpay
# dashboard (Settings -> Webhooks) — NOT the same value as
# RAZORPAY_KEY_SECRET. See app/api/payments/webhook/route.ts.
RAZORPAY_WEBHOOK_SECRET=""

VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

BLOB_READ_WRITE_TOKEN=""

# Brevo (brevo.com) — free tier covers plenty of testing volume. Get
# BREVO_API_KEY from Account -> SMTP & API -> API Keys. BREVO_SENDER_EMAIL
# must be a verified sender (Senders, Domains & Dedicated IPs -> Senders
# -> Add a sender, then verify it — a single mailbox is enough to start).
# Without these two, lib/email.ts falls back to logging to the console
# instead of failing outright.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Sarika Beauty Hub"

# `npm run db:seed` creates fixed demo accounts (see prisma/seed.ts) so
# the frontend's built-in "demo credentials" hints stay accurate without
# editing those pages:
#   Admin:     admin@sarikabeautyhub.in / admin123
#   Agents:    rahul.verma@sarikadelivery.in (and 2 others) / agent123
#   Customer:  demo@sarikabeautyhub.in / demo123
# Change these — or edit prisma/seed.ts and re-seed — before using
# anything but a throwaway local database.
