{
  "name": "sarika-beauty-hub-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Sarika Beauty Hub — JSON API backend (Next.js API routes + Prisma/PostgreSQL) for the jewellery storefront, admin console, and delivery-agent app. Adapted from a sweet-shop backend of the same architecture — see README.md.",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8",
    "@prisma/client": "5.18.0",
    "bcryptjs": "2.4.3",
    "jose": "5.6.3",
    "razorpay": "2.9.4",
    "web-push": "3.6.7",
    "@vercel/blob": "0.23.4"
  },
  "devDependencies": {
    "prisma": "5.18.0",
    "tsx": "4.16.5",
    "typescript": "5.5.4",
    "@types/node": "20.14.11",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/bcryptjs": "2.4.6",
    "@types/web-push": "3.6.3",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5"
  }
}
